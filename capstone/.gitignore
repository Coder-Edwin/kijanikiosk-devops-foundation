# Terraform local state and provider cache (state stays on the engineer's machine)
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/crash.log
infra/terraform/*.tfplan

# Ansible retry files
*.retry

# Node build output and dependencies
app/node_modules/
app/dist/

# Local environment files never committed
.env
.env.*
